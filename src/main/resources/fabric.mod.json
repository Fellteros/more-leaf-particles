{
  "schemaVersion": 1,
  "id": "more-leaf-particles",
  "version": "${version}",
  "name": "More Leaf Particles",
  "description": "Changes the default leaf particle's texture based on the leaves that it originates from.",
  "authors": [
    "Fellter"
  ],
  "contact": {
    "issues": "https://github.com/Fellteros/more-leaf-particles/issues",
    "homepage": "https://modrinth.com/mod/more-leaf-particles",
    "sources": "https://github.com/Fellteros/more-leaf-particles"
  },
  "license": "CC-BY-4.0",
  "icon": "assets/more-leaf-particles/icon.png",
  "environment": "client",
  "accessWidener": "more-leaf-particles.accesswidener",
  "entrypoints": {
    "client": [
      "net.fellter.moreLeafParticles.client.MoreLeafParticlesClient"
    ],
    "main": [
      "net.fellter.moreLeafParticles.MoreLeafParticles"
    ],
    "modmenu": [
      "net.fellter.moreLeafParticles.yacl.ModMenuImpl"
    ]
  },
  "mixins": [
    "more-leaf-particles.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
    "minecraft": "${minecraft_version}"
  }
}
