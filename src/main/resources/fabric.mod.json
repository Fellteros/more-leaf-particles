{
  "schemaVersion": 1,
  "id": "more_leaf_particles",
  "version": "${mod_version}",
  "name": "More Leaf Particles",
  "description": "Mod changing the default leaf particle's texture based on the leaves that it originates from.",
  "authors": [
    "Fellter"
  ],
  "contact": {
    "issues": "https://github.com/Fellteros/more-leaf-particles/issues",
    "homepage": "https://modrinth.com/mod/more-leaf-particles",
    "sources": "https://github.com/Fellteros/more-leaf-particles"
  },
  "license": "CC-BY-4.0",
  "icon": "assets/more_leaf_particles/icon.png",
  "environment": "client",
  "accessWidener": "classtweakers/${aw_path}",
  "entrypoints": {
    "client": [
      {
        "adapter": "kotlin",
        "value": "net.fellter.more_leaf_particles.client.MoreLeafParticlesClient"
      }
    ],
    "main": [
      {
        "adapter": "kotlin",
        "value": "net.fellter.more_leaf_particles.MoreLeafParticles"
      }
    ],
    "modmenu": [
      "net.fellter.more_leaf_particles.config.ModMenuImpl"
    ]
  },
  "mixins": [
    "more_leaf_particles.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${compatible_with}",
    "java": ">=21"
  },
  "suggests": {
    "modmenu": "${deps_modmenu}",
    "yet_another_config_lib_v3": "${deps_yacl}",
    "particlerain": "${deps_particleRain}"
  }
}
